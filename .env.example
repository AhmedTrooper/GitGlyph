# GitHub Personal Access Token (PAT)
# Generate a classic token or fine-grained PAT with read-only permissions (e.g. read:user or public repo access)
# This increases GitHub API rate limits from 60 to 5,000 requests per hour.
GITHUB_TOKEN=your_github_token_here

# Default GitHub Username to display if no ?username= query parameter is specified
GITHUB_USERNAME=your_github_username

# Optional Default Repository to showcase if no ?repo= query parameter is specified
GITHUB_REPO=your_repo_name

# Optional production app domain for README snippet generation
NEXT_PUBLIC_APP_URL=https://git-glyph.vercel.app
